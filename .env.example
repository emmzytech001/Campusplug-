# Managed Webdev injects DATABASE_URL, MANUS_API_URL and MANUS_API_KEY in Cloud.
# For local development, provide the same values through the project environment.
PORT=3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated email addresses that receive the CampusPlug admin role.
ADMIN_EMAILS=owner@example.com
# Optional: set a public base URL for Google OAuth outside Preview.
PUBLIC_APP_URL=
